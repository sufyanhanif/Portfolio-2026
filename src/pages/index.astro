---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import Navbar from '../components/layouts/Navbar.jsx';
import HeroSection from '../components/sections/HeroSection.jsx';
import About from '../components/sections/About.jsx';
import Project from '../components/sections/Project.jsx';
import Certificate from '../components/sections/Certificate.jsx';
import LoadingScreen from '../components/common/LoadingScreen.jsx';
---

<Layout>
  <LoadingScreen client:only="react" />
  <main class="relative w-full h-screen overflow-y-scroll overflow-x-hidden bg-black text-white selection:bg-fuchsia-500 selection:text-white">
    <Navbar client:load />
    <HeroSection client:load />
    <About client:load />
    <Project client:load />
    <Certificate client:load />
  </main>
</Layout>